{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Mangos":     "Server=mariadb;Port=3306;Database=mangos;User=mangos;Password=mangos;",
    "Characters": "Server=mariadb;Port=3306;Database=characters;User=mangos;Password=mangos;",
    "Realmd":     "Server=mariadb;Port=3306;Database=realmd;User=mangos;Password=mangos;",
    "Logs":       "Server=mariadb;Port=3306;Database=logs;User=mangos;Password=mangos;",
    "Admin":      "Server=mariadb;Port=3306;Database=vmangos_admin;User=mangos;Password=mangos;"
  },

  "Vmangos": {
    "BinDirectory":    "/opt/superui-core/bin",
    "LogDirectory":    "/opt/superui-core/logs",
    "ConfigDirectory": "/opt/superui-core/etc",
    "MangosdProcess":  "mangosd-main",
    "RealmdProcess":   "realmd-main",
    "MangosdConfPath": "/opt/superui-core/etc/mangosd.conf",
    "LogsDir":         "/opt/superui-core/bin",
    "DbcPath":         "/opt/superui-core/data/5875/dbc",
    "MapsDataPath":    "/opt/superui-core/data/maps",
    "ServerDataPath":  "/opt/superui-core/data",
    "ClientDataPath":  "/data/Data",

    "//Commands": "Shell templates run by ProcessManagerService. Placeholders: {unit} = process name, {action} = start|stop|restart. Empty = service falls back to Process.Kill() (works in docker-compose where the UI shares mangosd's PID namespace). On a systemd host, set them to 'sudo systemctl {action} {unit}'.",
    "MangosdStartCommand":   "",
    "MangosdStopCommand":    "",
    "MangosdRestartCommand": "",
    "RealmdStartCommand":   "",
    "RealmdStopCommand":    "",
    "RealmdRestartCommand": ""
  },

  "RemoteAccess": {
    "Host": "mangosd",
    "Port": 3443,
    "Username": "superui",
    "Password": "Changeme123!",
    "ReconnectDelayMs": 3000,
    "CommandTimeoutMs":  5000
  },

  "Mcp": {
    "Enabled": true,
    "Route": "/mcp",
    "Auth": {
      "RequireBearerToken": true,
      "EnvVarName": "MCP_AUTH_TOKEN",
      "AllowOrigins": [],
      "//Tokens": "Each entry: { token, label, capabilities[] }. Token grants all caps if list empty. Legacy MCP_AUTH_TOKEN env var still works as a superuser fallback.",
      "Tokens": []
    },
    "Audit": {
      "OperatorName": "mcp-client"
    }
  },

  "SpellCreator": {
    "Ollama": { "BaseUrl": "http://host.docker.internal:11434" },
    "ComfyUI": { "Nodes": [] }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
    }
  }
}

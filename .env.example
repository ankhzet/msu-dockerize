# ============================================================================
# MangosSuperUI Docker Stack - Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# Sensitive defaults are intentionally insecure for local-only development.
# ============================================================================

# ---------- Image / build tuning ----------
# Set to 1 to rebuild images from local cache (uses ./vendor/)
# Set to 0 to pull base images without rebuilding
REBUILD=1

# Pinned versions (matches GitHub release tags)
MANGOS_SUPER_UI_VERSION=v1.2
SUPERUI_CORE_VERSION=latest

# ---------- SuperUI-Core source build ----------
# Set BUILD_FROM_SOURCE=1 to skip the prebuilt artifact download and instead
# compile SuperUI-Core from the local submodule at vendor/SuperUI-Core/.
# The build runs inside a throwaway ubuntu:24.04 container that mirrors
# the upstream CI workflow. Output goes to vendor/dev-<sha>.tar.gz and is
# then consumed by the regular `docker compose build mangosd`.
#
# One-time setup (on the host, before the first build):
#   git submodule update --init vendor/SuperUI-Core
#
# Usage:
#   docker compose --profile source-build run --rm superui-core-builder
#   docker compose build mangosd
#   docker compose up -d
#
# To pull a newer commit from upstream:
#   git submodule update --remote vendor/SuperUI-Core
#   docker compose --profile source-build run --rm superui-core-builder
#
# CMAKE_BUILD_TYPE: RelWithDebInfo (default; -O2 + -g, ~50% larger binary but
# gdb/backtraces work). Release for a smaller stripped binary, or Debug for
# an unoptimized build (very slow).
# BUILD_EXTRACTORS: 1 to build MoveMap/VMap/Map extractors (default, matches
# upstream), 0 to skip them and shave a few minutes off the build.
# DOTNET_BUILD_CONFIG: Release (default, matches upstream's FolderProfile.pubxml).
# DOTNET_RUNTIME_ID: linux-x64 (default, matches upstream's pubxml).
BUILD_FROM_SOURCE=0
CMAKE_BUILD_TYPE=RelWithDebInfo
BUILD_EXTRACTORS=1
DOTNET_BUILD_CONFIG=Release
DOTNET_RUNTIME_ID=linux-x64

# ---------- Database (MariaDB) ----------
MARIADB_VERSION=10.11
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=mangos
MARIADB_USER=mangos
MARIADB_PASSWORD=mangos

# MangosSuperUI's own admin database (audit, history, etc.)
MANGOS_ADMIN_DB=vmangos_admin

# ---------- MangosSuperUI web UI ----------
# ASP.NET Core 8.0 listen URL (host:port from the perspective of the container)
UI_HTTP_PORT=5000

# ---------- Realmd (auth server) ----------
REALMD_HTTP_PORT=3724

# ---------- Mangosd (world server) ----------
# Container port exposed to the host's localhost only - never expose publicly
MANGOSD_RA_PORT=3443

# IP the RA socket binds to inside the container. 0.0.0.0 = all interfaces.
RA_IP=0.0.0.0

# ---------- Remote Access (RA) credentials ----------
# Used by MangosSuperUI to log into mangosd's RA console.
# Strongly recommended to change these even for a local-only stack.
RA_USERNAME=superui
RA_PASSWORD=Changeme123!
RA_MIN_LEVEL=3
RA_HOST=mangosd
RA_PORT=3443

# ---------- WoW client ----------
# Path on the HOST to your WoW 1.12.1 client. Can be either the client root
# (containing Data/, WoW.exe, *.MPQ) OR just the Data/ subdirectory.
# Once set, run `./scripts/extract-client-data.sh` to extract DBC/Maps/VMaps
# into the running container.
# Examples:
#   Windows: WOW_CLIENT_DATA=C:/Games/WoW_1.12.1
#   Linux:   WOW_CLIENT_DATA=/home/me/wow
#   macOS:   WOW_CLIENT_DATA=/Users/me/wow
# Leave empty if you don't have a client yet.
WOW_CLIENT_DATA=

# Path INSIDE the container where the client is mounted (don't change unless
# you know what you're doing - the extract script and entrypoint expect this).
CLIENT_DATA_PATH=/data

# ---------- World DB (brotalnia/database) ----------
# Choices:
#   bare      - empty schemas; user supplies DB or runs download later (DEFAULT)
#   standard  - download the smallest available world DB archive
#   full      - download latest world DB archive
#   <URL>     - direct URL to a .7z archive
#   <PATH>    - local path on the host to a .7z or .sql file
WORLD_DB_MODE=bare

# Pin to the smallest available in the brotalnia repo (Feb 2018 still 200MB+)
# Override with a newer URL if you want more content.
WORLD_DB_STANDARD_URL=https://github.com/brotalnia/database/raw/master/world_full_02_february_2018.7z
WORLD_DB_FULL_URL=https://github.com/brotalnia/database/raw/master/world_full_14_june_2021.7z

# ---------- Optional AI services ----------
# Set to 1 to enable the optional Ollama / ComfyUI profiles.
# These services are NOT downloaded at build time - they're pre-configured
# to either connect to your host gateway (OLLAMA_HOST/COMFYUI_HOST) or pull
# a model on first run.
ENABLE_OLLAMA=0
ENABLE_COMFYUI=0

# If you already run Ollama/ComfyUI on the host (e.g. LM Studio, llama.cpp),
# set the gateway URLs so the UI can reach them through the docker network.
OLLAMA_HOST=http://host.docker.internal:11434
COMFYUI_HOST=http://host.docker.internal:8188

# Ollama model to pull on first run (skipped if already present)
OLLAMA_MODEL=qwen3:4b

# ---------- Timezone ----------
TZ=UTC

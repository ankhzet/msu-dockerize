# Build artifacts
**/bin/
**/obj/
**/.vs/
**/*.user
*.suo

# Local caches and secrets
.env
.env.local
*.pem
*.key

# Runtime data
backups/*
!backups/.gitkeep
logs/*
!logs/.gitkeep
data/

# Submodule sources. Only the source-build compose services need these
# (and they bind-mount ./:/work so they don't need them in the build
# context). Excluding them slims the runtime image build context from
# ~5 GB down to a few MB.
vendor/SuperUI-Core/
vendor/MangosSuperUI/

# Build cache lives under vendor/builds/ but is NOT needed in the image:
# the runtime Dockerfiles COPY only vendor/current/ (hardlinks) + vendor/sql/.
# The hardlinks deref into the real archives, so vendor/builds/* itself
# stays out of the image. Run ./scripts/sync-vendor.sh --keep 1 to prune.
vendor/builds/

# World DB archives (intentionally excluded so they're not baked into
# the image - they're handled by init-database.sh at runtime instead).
vendor/*.7z
vendor/*.tar.xz

# vendor/current/ contains hardlinks + .meta sidecars (NOT excluded).

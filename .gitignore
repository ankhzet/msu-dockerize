# Environments / secrets
.env
.env.local
.env.*.local

# Vendor / build cache (populated by scripts/download-artifacts.*)
vendor/*.zip
vendor/*.7z
vendor/*.tar.gz
vendor/*.tar.xz
vendor/*.tar.bz2
vendor/sql/*.sql
!vendor/sql/.gitkeep
vendor/sql/migrations/
vendor/sql/old_migrations/
vendor/CHANGELOG*
vendor/README*.md
!vendor/README.md
vendor/superui-core-*
vendor/MangosSuperUI-*

# Temporary shallow clones and workdirs (git-managed but transient)
.tmp-core/
.tmp-msui/
.tmp-*/

# Backups
backups/*
!backups/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# IDE / editor
.vs/
.idea/
*.user
*.suo
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
**/bin/
**/obj/
**/out/

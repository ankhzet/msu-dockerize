# Environments / secrets
.env
.env.local
.env.*.local

# Vendor / build cache (populated by scripts/download-artifacts.* and the
# source-build compose services). All build artifacts go under vendor/builds/
# so they're easy to wipe, prune, and inspect. vendor/current/ holds the
# hardlinks the runtime images read (an actively-managed pointer, not
# source - generated by scripts/sync-vendor.sh or scripts/switch-build.sh).
# vendor/SuperUI-Core and vendor/MangosSuperUI are submodules - registered
# by feature/bridge-gear-up via 'git submodule update --init'. On master
# they appear as untracked working-tree folders only if they were cloned
# manually; don't add them here.
vendor/builds/
vendor/current/
vendor/*.zip
vendor/*.7z
vendor/*.tar.gz
vendor/*.tar.xz
vendor/*.tar.bz2
vendor/sql/*.sql
!vendor/sql/.gitkeep
vendor/sql/migrations/
vendor/sql/old_migrations/
vendor/CHANGELOG*
vendor/README*.md
!vendor/README.md
vendor/superui-core-*
vendor/MangosSuperUI-*

# Temporary shallow clones and workdirs (git-managed but transient)
.tmp-core/
.tmp-msui/
.tmp-*/

# Backups
backups/*
!backups/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# IDE / editor
.vs/
.idea/
*.user
*.suo
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
**/bin/
**/obj/
**/out/

# Worktrees (git worktree add ...) get gitignored so per-worktree build artefacts
# (vendor/builds, vendor/current, etc.) don't get accidentally staged.
.worktrees/

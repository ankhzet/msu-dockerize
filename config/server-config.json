{
  "//": "Bundled default server-config.json. The UI container entrypoint rewrites this on every start from environment variables. To customize, mount a different file at /opt/mangossuperui/server-config.json or override the env vars in .env.",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Mangos":     "Server=mariadb;Port=3306;Database=mangos;User=mangos;Password=mangos;",
    "Characters": "Server=mariadb;Port=3306;Database=characters;User=mangos;Password=mangos;",
    "Realmd":     "Server=mariadb;Port=3306;Database=realmd;User=mangos;Password=mangos;",
    "Logs":       "Server=mariadb;Port=3306;Database=logs;User=mangos;Password=mangos;",
    "Admin":      "Server=mariadb;Port=3306;Database=vmangos_admin;User=mangos;Password=mangos;"
  },

  "Vmangos": {
    "BinDirectory":      "/opt/superui-core/bin",
    "LogDirectory":      "/opt/superui-core/logs",
    "ConfigDirectory":   "/opt/superui-core/etc",
    "MangosdProcess":    "mangosd",
    "RealmdProcess":     "realmd",
    "MangosdConfPath":   "/opt/superui-core/etc/mangosd.conf",
    "LogsDir":           "/opt/superui-core/bin",
    "DbcPath":           "/opt/superui-core/data/5875/dbc",
    "MapsDataPath":      "/opt/superui-core/data/maps",
    "ServerDataPath":    "/opt/superui-core/data",
    "ClientDataPath":    "/data"
  },

  "RemoteAccess": {
    "Host": "mangosd",
    "Port": 3443,
    "Username": "superui",
    "Password": "Changeme123!",
    "ReconnectDelayMs": 3000,
    "CommandTimeoutMs":  5000
  },

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
    }
  }
}